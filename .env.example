# 复制为 .env 后修改。不要把 .env 提交到代码仓库。
SCM_DB_PASSWORD=请改成强密码
MYSQL_ROOT_PASSWORD=请改成另一个强密码
# 至少 32 个字符的随机字符串，可用：openssl rand -base64 48
SCM_JWT_SECRET=请改成至少32位的随机字符串
# 首次启动创建的管理员 admin 的初始密码
SCM_ADMIN_PASSWORD=请改成初始管理员密码
# 测试环境可设为 true 写入示例数据；生产环境保持 false
SCM_DEMO_DATA=false
# 电商 ERP 调用对接接口时带的密钥（请求头 X-Api-Key），留空则关闭对接接口。可用：openssl rand -hex 32
SCM_INTEGRATION_API_KEY=
# 一物一码扫码地址前缀（印在包装二维码里），改成正式域名
SCM_VERIFY_URL_PREFIX=https://scm.example.com/v/
SCM_HTTP_PORT=80
# 启用 HTTPS 叠加配置时的端口（见 README 部署一节）
SCM_HTTPS_PORT=443
# 每天几点自动备份数据库、备份保留多少天
SCM_BACKUP_AT=02:30
SCM_BACKUP_KEEP_DAYS=30
# 每日待办提醒（可选）：SCM_NOTIFY_ENABLED=true 启动定时任务；时间是 Asia/Shanghai，默认每天 8:30
SCM_NOTIFY_ENABLED=false
SCM_NOTIFY_CRON="0 30 8 * * *"
# 企业微信群机器人地址（含密钥）
SCM_NOTIFY_WECOM_WEBHOOK=
# 邮件：默认 465 端口 SSL；收件人多个用英文逗号隔开
SCM_SMTP_HOST=
SCM_SMTP_PORT=465
# 465 端口用 SSL；25 / 587 端口把下面改成 false
SCM_SMTP_SSL=true
SCM_SMTP_AUTH=true
SCM_SMTP_USERNAME=
SCM_SMTP_PASSWORD=
SCM_NOTIFY_MAIL_TO=

# 打开后，安全评估和标签没签批的不能上市放行。资料补齐后再打开
SCM_COMPLIANCE_REQUIRE_DOCS=false

# 打开后，发起配方变更要先在“变更控制”里有一项已批准的配方或原料变更
SCM_REQUIRE_CHANGE_FOR_FORMULA=false
